# Copy to .env on the office PC. Never commit .env.
WORKER_TOKEN=
# Leave at 0 until the exact success message has been inspected and configured.
ALLOW_SUBMIT=0
CONFIRMED_SUCCESS_TEXT=
POLL_SECONDS=5
# Receipts are only saved ("Receive & send to finance") when ALLOW_SUBMIT=1 AND this is the exact
# success message the workplace shows afterwards. Leave empty: receipts are then filled in only.
RECEIPT_SUCCESS_TEXT=
